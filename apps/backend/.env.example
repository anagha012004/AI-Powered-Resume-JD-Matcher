# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-long-random-string-min-32-chars

# ── Primary LLM: Gemini ───────────────────────────────────────────────────────
# Free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Fallback LLM 1: Groq (https://console.groq.com) ──────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Fallback LLM 2: OpenRouter (https://openrouter.ai) ───────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite+aiosqlite:///./resume_matcher.db

# ── Optional: Celery async batch jobs ────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Pipeline tuning ───────────────────────────────────────────────────────────
LOW_SIMILARITY_THRESHOLD=0.25
CACHE_TTL=86400
